# Laravel & Vue.js .gitignore

# Environment
.env
.env.*.local
.phpunit.result.cache

# Composer / PHP
/vendor/
composer.phar

# Node / JS / Vue
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/public/hot
/public/build
/dist
/.vite
/.cache

# Build artifacts (may be generated by webpack/mix/vite)
mix-manifest.json
/public/mix-manifest.json
/public/js/*.map
/public/css/*.map

# Laravel storage & logs
/storage/*.key
/storage/debugbar
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/views
/storage/logs

# Bootstrap cache (compiled files)
bootstrap/cache/*.php

# IDEs and editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Vagrant / Homestead
Homestead.yaml
Homestead.json
/.vagrant

# Misc
.php_cs.cache
php_cs.cache
*.log